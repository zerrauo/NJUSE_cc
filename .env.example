# 复制此文件为 .env 并填入你的 API key（.env 已被 gitignore，不会入库）
DEEPSEEK_API_KEY=sk-your-key-here

# OpenAI 兼容网关的地址与模型名，默认指向 DeepSeek 官方
AGENT_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-chat

# 可选调优项（均有默认值，一般无需修改）
# AGENT_MAX_TURNS=30          # 最大工具调用轮数，超过后强制收尾
# AGENT_MAX_CONTEXT=48000     # 估算 token 超过该值时触发历史摘要压缩
# AGENT_KEEP_RECENT=8         # 压缩时原样保留的最近消息条数
